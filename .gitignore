# Runtime Storage (keep directory scaffolding & Apache .htaccess locks)
/storage/logs/*
!/storage/logs/.gitkeep
!/storage/logs/.htaccess

/storage/sessions/*
!/storage/sessions/.gitkeep
!/storage/sessions/.htaccess

/storage/cache/blade/*
!/storage/cache/blade/.gitkeep
!/storage/cache/blade/.htaccess

/storage/departments/*/*
!/storage/departments/*/.gitkeep
!/storage/departments/*/.htaccess

