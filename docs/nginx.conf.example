# ==============================================================================
# Wildcrest Lodges & Camps - Production Nginx Configuration Example
# ==============================================================================
# Copy and adapt for your domain and PHP-FPM socket/port.
#
# CRITICAL SECURITY DESIGN:
#   `root` MUST point exclusively to `<project>/public`, NEVER the project root.
#   Non-web directories (`storage/`, `src/`, `config/`, `database/`, `vendor/`,
#   `resources/`, `.env`) stay outside the web document root and are additionally
#   blocked below as defense in depth.
# ==============================================================================

server {
    listen 80;
    listen [::]:80;
    server_name lodges.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name lodges.example.com;

    # TLS certificates managed by Let's Encrypt / platform PKI
    ssl_certificate     /etc/letsencrypt/live/lodges.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/lodges.example.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;

    # Expose ONLY the public/ directory
    root /var/www/wildcrest-lodges/public;
    index index.php;

    charset utf-8;
    client_max_body_size 8M;

    # Hide server version token
    server_tokens off;

    # Edge security headers (complementing application SecurityHeaders middleware)
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;

    # Block dotfiles (.env, .htaccess, .git, etc.)
    location ~ /\.(?!well-known).* {
        deny all;
        return 404;
    }

    # Defense-in-depth denial if misconfigured symlink/alias ever reaches internals
    location ~* ^/(storage|src|config|database|resources|vendor|tests)/ {
        deny all;
        return 404;
    }

    # Block direct execution of any PHP file other than the public front controller
    location ~ \.php$ {
        location ~ ^/index\.php$ {
            try_files $uri =404;
            include fastcgi_params;
            fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
            fastcgi_param DOCUMENT_ROOT $realpath_root;
            fastcgi_pass unix:/run/php/php8.3-fpm.sock;
            fastcgi_hide_header X-Powered-By;
        }
        return 404;
    }

    # Static assets cache headers (safe because versioned/read-only SVG/CSS/JS)
    location ~* \.(css|js|svg|png|jpg|jpeg|webp|woff2?)$ {
        expires 7d;
        add_header Cache-Control "public, no-transform";
        try_files $uri =404;
    }

    # Route all application paths through public/index.php
    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }
}
