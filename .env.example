# ==============================================================================
# Wildcrest Lodges & Camps - Environment Configuration Example
# ==============================================================================
# Copy this file to `.env` and adjust values for your environment.
# `.env` is the SINGLE SOURCE OF TRUTH for all configurable runtime settings.
# NEVER commit `.env` with real credentials or secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Settings
# ------------------------------------------------------------------------------
APP_NAME="Wildcrest Lodges & Camps"
# Allowed values: local, staging, production
APP_ENV=local
# Must be false in production (controls diagnostic verbosity, never leaks stack traces to users)
APP_DEBUG=true
# Full base URL without trailing slash (e.g. http://127.0.0.1:8000 or http://localhost/TOP/public)
APP_URL=http://127.0.0.1:8000
# Optional URL path prefix when hosted in a subdirectory (e.g. /TOP/public in XAMPP). Leave empty for root vhost.
APP_BASE_PATH=
APP_TIMEZONE=UTC
APP_LOCALE=en

# Public contact details displayed on public pages & structured data
CONTACT_EMAIL=concierge@wildcrestlodges.example
CONTACT_PHONE="+27 11 555 0194"
BUSINESS_LOCATION="Limpopo & Okavango Conservation Circuit"

# ------------------------------------------------------------------------------
# Database (MariaDB 10.4+ / 10.11+ via PDO)
# ------------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=wildcrest_lodges
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# ------------------------------------------------------------------------------
# Session Security [SECURITY:SESSION]
# ------------------------------------------------------------------------------
SESSION_NAME=wildcrest_sid
# Relative to project root or absolute path; must NOT be web-accessible
SESSION_SAVE_PATH=storage/sessions
# Idle timeout in seconds (1800 = 30 minutes)
SESSION_LIFETIME_IDLE=1800
# Absolute session max lifetime in seconds (28800 = 8 hours)
SESSION_LIFETIME_ABSOLUTE=28800
# Set to true when served over HTTPS in staging/production
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
# Allowed values: Lax, Strict
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_PATH=/
SESSION_COOKIE_DOMAIN=

# ------------------------------------------------------------------------------
# Password Hashing [SECURITY:PASSWORD]
# ------------------------------------------------------------------------------
# Preferred algorithm: argon2id (falls back to bcrypt if Argon2id is unavailable)
PASSWORD_HASH_ALGO=argon2id
PASSWORD_ARGON2_MEMORY_COST=65536
PASSWORD_ARGON2_TIME_COST=4
PASSWORD_ARGON2_THREADS=1
PASSWORD_BCRYPT_COST=12

# ------------------------------------------------------------------------------
# Brute-Force Protection [SECURITY:BRUTE-FORCE]
# ------------------------------------------------------------------------------
AUTH_MAX_ATTEMPTS_PER_USER=5
AUTH_MAX_ATTEMPTS_PER_IP=15
# Sliding lockout window in seconds (900 = 15 minutes)
AUTH_LOCKOUT_SECONDS=900
# Exponential delay base & cap in seconds applied before rejecting repeated failures
AUTH_BACKOFF_BASE_SECONDS=2
AUTH_BACKOFF_MAX_SECONDS=10

# ------------------------------------------------------------------------------
# CSRF & HTTP Security Headers [SECURITY:CSRF] [SECURITY:XSS]
# ------------------------------------------------------------------------------
CSRF_TOKEN_NAME=_csrf_token
CSRF_HEADER_NAME=X-CSRF-Token
CSP_POLICY="default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
REFERRER_POLICY=strict-origin-when-cross-origin
PERMISSIONS_POLICY="camera=(), microphone=(), geolocation=(), payment=()"

# ------------------------------------------------------------------------------
# BladeOne View Engine [CONFIG:BLADEONE]
# ------------------------------------------------------------------------------
# Paths are relative to project root unless absolute
VIEW_PATH=resources/views
VIEW_CACHE_PATH=storage/cache/blade
# Allowed values: debug (always recompile), auto (recompile on change), fast (compiled only)
VIEW_MODE=debug

# ------------------------------------------------------------------------------
# Logging [SECURITY:ERRORS]
# ------------------------------------------------------------------------------
LOG_CHANNEL=wildcrest
LOG_PATH=storage/logs/app.log
# Allowed values: debug, info, notice, warning, error, critical, alert, emergency
LOG_LEVEL=debug
LOG_MAX_FILES=14

# ------------------------------------------------------------------------------
# Department File Uploads
# ------------------------------------------------------------------------------
UPLOAD_STORAGE_PATH=storage/departments
# 5242880 bytes = 5 MiB
UPLOAD_MAX_BYTES=5242880
UPLOAD_ALLOWED_EXTENSIONS=pdf,txt,csv,png,jpg,jpeg,webp,docx,xlsx
UPLOAD_ALLOWED_MIMES="application/pdf,text/plain,text/csv,image/png,image/jpeg,image/webp,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"

# ------------------------------------------------------------------------------
# Domain Limits & Pagination
# ------------------------------------------------------------------------------
BOOKING_MAX_GUESTS_DEFAULT=12
BOOKING_CURRENCY=USD
CATALOG_PER_PAGE=9
STAFF_TASKS_PER_PAGE=15
